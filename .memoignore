# .memoignore — gitignore syntax. Files matched here are skipped by memo's indexer.
# Generated by `python -m memo.cli init`; edit freely, memo will not overwrite it.

# VCS internals — nothing indexable, and .git can hold a huge object tree
.git/
.svn/
.hg/

# Dependencies / build output
node_modules/
bin/
obj/
dist/
build/
out/
*.egg-info/
.venv/
venv/
__pycache__/
packages/
TestResults/
.vs/
.idea/
wwwroot/lib/

# The cache itself
.memo/

# Minified / generated assets
*.min.js
*.min.css
*-bundle.js
*.designer.cs
*.Designer.vb
*.g.cs
*.g.i.cs
*.generated.cs
Reference.cs
